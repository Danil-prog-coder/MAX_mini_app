# Контекст сборки для всех образов — корень репозитория (см. docker-compose.yml),
# поэтому здесь отсекается всё, что в образы попадать не должно.

.git
.gitignore
.dockerignore
.claude

# секреты
.env
.env.*
!.env.example

# документация и дизайн-исходники — в рантайме не нужны
docs

# артефакты локальной разработки
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.vite
**/*.tsbuildinfo
**/playwright-report
**/test-results
data
