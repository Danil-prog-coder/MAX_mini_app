# Админка на отдельном поддомене (уточнение У26, тех. ТЗ 9.4).
#
# Чтобы включить: скопируйте этот файл на сервере рядом, без `.example`,
# и подставьте свой домен вместо `admin.example.ru`.
#
#     cp conf.d/admin.caddy.example conf.d/admin.caddy
#     docker compose -f docker-compose.prod.yml restart caddy
#
# Отдельный домен, а не путь `/admin` на общем: в её очередях лежат тексты
# обращений пользователей, и одна ошибка в `handle` на общем домене открыла бы
# их всему интернету. Разные домены такой ошибки не прощают молча.
#
# Доступ внутри — HTTP Basic по ADMIN_USERNAME и ADMIN_PASSWORD; без пароля
# приложение не поднимается. Домен тоже должен указывать на этот сервер,
# иначе Caddy не выпустит на него сертификат.

admin.example.ru {
	encode zstd gzip
	reverse_proxy admin:8001

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format console
	}
}
