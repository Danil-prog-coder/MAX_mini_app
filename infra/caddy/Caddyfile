# Единственная точка входа стенда.
#
# Caddy выбран не за моду: сертификат Let's Encrypt он выпускает и продлевает
# сам, без cron и certbot, а весь конфиг — двадцать строк вместо страницы
# директив nginx. Для стенда, который поднимает один человек, это решающее.
#
# Одно правило, из которого следует всё остальное: фронтенд и API живут на
# **одном** домене. Поэтому браузер не делает кросс-доменных запросов, CORS не
# участвует, а мини-приложению внутри WebView мессенджера MAX не нужно знать
# отдельный адрес бэкенда (решение Р67).

{$DOMAIN} {
	encode zstd gzip

	# API — по префиксу.
	handle /api/* {
		reverse_proxy core-api:8000
	}

	# Проба живости наружу: деплой убеждается, что стенд поднялся, не заходя
	# на сервер по SSH.
	handle /health {
		reverse_proxy core-api:8000
	}

	# Всё остальное — статика мини-приложения. SPA-фолбэк настроен внутри её
	# nginx, поэтому здесь просто проксирование.
	handle {
		reverse_proxy miniapp:80
	}

	header {
		# Заголовки безопасности. CSP намеренно не задаётся: требования
		# платформы MAX к WebView лежат в закрытой документации (тех. ТЗ 9.7)
		# и ещё не сверены — выставить её наугад значит сломать приложение
		# внутри мессенджера.
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Дополнительные сайты — файлами рядом. Глоб без совпадений Caddy не считает
# ошибкой, поэтому по умолчанию здесь не подключается ничего.
#
# Так сделана админка: подставлять `{$ADMIN_DOMAIN}` прямо в конфиг нельзя —
# незаданная переменная превратилась бы в пустой адрес сайта, и Caddy не
# поднялся бы вовсе, уронив вместе с собой весь стенд. Как включить —
# в `conf.d/admin.caddy.example`.
import /etc/caddy/conf.d/*.caddy
